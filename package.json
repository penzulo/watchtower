{
	"name": "watchtower",
	"private": true,
	"workspaces": [
		"client",
		"server",
		"shared"
	],
	"scripts": {
		"dev": "concurrently -c \"cyan,magenta\" \"bun:dev:server\" \"bun:dev:client\"",
		"dev:client": "bun --bun run --cwd client dev",
		"dev:server": "bun --bun run --cwd server dev",
		"build": "bun --bun run --filter '*' build",
		"build:client": "bun --bun run --cwd client build",
		"test": "bun --bun run --filter '*' test",
		"lint": "bun --bun run --cwd client lint",
		"check": "bun --bun run --cwd client check",
		"format": "bun --bun run --cwd client format",
		"typecheck": "bun --bun run --filter '*' typecheck",
		"infra:up": "docker compose up -d",
		"infra:down": "docker compose down",
		"infra:logs": "docker compose logs -f",
		"prepare": "husky"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.0",
		"concurrently": "^10.0.3",
		"husky": "^9.1.7",
		"lint-staged": "^17.0.7"
	},
	"lint-staged": {
		"*": [
			"bunx @biomejs/biome check --write --unsafe --no-errors-on-unmatched"
		]
	}
}
