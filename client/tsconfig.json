{
	"include": ["**/*.ts", "**/*.tsx"],
	"references": [
		// Reference shared first — server may also depend on it
		{ "path": "../shared" },
		{ "path": "../server" }
	],
	"compilerOptions": {
		"target": "ES2022",
		"jsx": "react-jsx",
		"module": "ESNext",
		"paths": {
			"@/*": ["./src/*"],
			// Allows: import type { App } from "@watchtower/server"
			"@watchtower/server": ["../server/src/index.ts"],
			// Allows: import { EventSchema } from "@watchtower/shared"
			"@watchtower/shared": ["../shared/src/index.ts"],
			// Allows: import { EventSchema } from "@shared/schemas"
			//         import { EventSchema } from "@shared/schemas/event"
			"@shared/*": ["../shared/src/*"]
		},
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"types": ["vite/client"],

		/* Bundler mode */
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"noEmit": true,

		/* Linting */
		"skipLibCheck": true,
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedSideEffectImports": true
	}
}
