{
	"include": ["**/*.ts", "**/*.tsx"],
	"references": [{ "path": "../shared" }, { "path": "../server" }],
	"compilerOptions": {
		"target": "ES2022",
		"jsx": "react-jsx",
		"module": "ESNext",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"types": ["vite/client"],

		/* Path aliases */
		"paths": {
			"@/*": ["./src/*"],
			"@watchtower/server": ["../server/src/index.ts"],
			"@watchtower/shared": ["../shared/src/index.ts"],
			"@shared/*": ["../shared/src/*"]
		},

		/* Bundler mode */
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"noEmit": true,

		/* Linting */
		"skipLibCheck": true,
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedSideEffectImports": true
	}
}
