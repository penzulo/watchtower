{
  "include": ["**/*.ts", "**/*.tsx"],
  "references": [
    // Reference the server package so TypeScript resolves the App type
    // exported from @watchtower/server without any "import not resolved" errors.
    { "path": "../server" }
  ],
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "module": "ESNext",
    "paths": {
      "#/*": ["./src/*"],
      "@/*": ["./src/*"],
      // Allows: import type { App } from "@watchtower/server"
      // This maps the package name to the server source so editors and tsc
      // resolve the Elysia App type without needing a build step first.
      "@watchtower/server": ["../server/src/index.ts"]
    },
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    /* Linting */
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  }
}
