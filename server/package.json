{
	"name": "@watchtower/server",
	"version": "1.0.50",
	"module": "src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./*": "./src/*/index.ts"
	},
	"scripts": {
		"dev": "bun run --watch src/index.ts",
		"build": "tsc && bun run scripts/build.ts",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@clickhouse/client": "^1.20.0",
		"@elysiajs/cors": "1.4.2",
		"@elysiajs/eden": "^1.4.9",
		"@watchtower/shared": "workspace:*",
		"bullmq": "^5.78.0",
		"elysia": "1.4.28",
		"ioredis": "5.10.1"
	},
	"devDependencies": {
		"bun-types": "latest",
		"typescript": "^6.0.2"
	}
}
