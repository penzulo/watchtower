{
	"compilerOptions": {
		"types": ["bun-types"],
		"composite": true,
		"incremental": true,
		"tsBuildInfoFile": "./.tsbuildinfo",
		"target": "ES2022",
		"module": "ESNext",
		"rootDir": "./src",
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": false,
		"verbatimModuleSyntax": true,
		"resolveJsonModule": true,
		"paths": {
			"@watchtower/shared": ["../shared/src/index.ts"],
			"@shared/*": ["../shared/src/*"],
			"@watchtower/server/*": ["./src/*"]
		},
		"declaration": true,
		"declarationMap": true,
		"outDir": "./dist",
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"skipLibCheck": true
	},
	"exclude": ["tests", "dist"],
	"references": [{ "path": "../shared" }]
}
